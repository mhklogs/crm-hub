# ─── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_NAME=CRM Hub

# ─── Auth ───────────────────────────────────────────────────────────────
# AUTH_SECRET is REQUIRED in production. Generate with:  npx auth secret
AUTH_SECRET=change-me-in-production

# ─── Microsoft Entra ID (Microsoft/Teams login) ─────────────────────────
# Register an app at https://portal.azure.com -> Entra ID -> App registrations
# Redirect URI:  http://localhost:3000/api/auth/microsoft/callback
# API permissions: User.Read, Chat.ReadWrite, Presence.Read, OnlineMeetings.ReadWrite
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ─── Twilio (voice / SMS dialer) ────────────────────────────────────────
# https://console.twilio.com -> API Keys
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── LiveKit (video rooms, Zoom-like) ───────────────────────────────────
# https://cloud.livekit.io
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Dev fallbacks: when a provider key is blank the app runs in MOCK mode so
# you can build the UI before adding real credentials.